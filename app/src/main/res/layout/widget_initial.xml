<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the launcher before the first Glance update and as the picker preview: the empty terminal, so a new
     widget never shows a "Loading" box. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101214"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:fontFamily="monospace"
        android:text="@string/widget_initial_text"
        android:textColor="#58A6FF"
        android:textSize="13sp" />
</FrameLayout>
